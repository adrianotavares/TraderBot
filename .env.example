BINANCE_API_KEY="your_testnet_api_key"
BINANCE_SECRET_KEY="your_testnet_secret_key"
TRADING_ENV=testnet
LOG_LEVEL=INFO
TRADING_CONFIG=config/trading.yaml

# --- Dashboard ---
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# Threads do servidor WSGI (waitress). Mantenha um único processo.
WSGI_THREADS=8
# Servidor de desenvolvimento com reload. Nunca use em produção.
FLASK_DEV_SERVER=0

# Login do dashboard. Gere com: python src/app/hash_password.py
# Sem este valor o dashboard fica sem tela de login (só o modo de token abaixo).
DASHBOARD_PASSWORD_HASH=
# Token para scripts e curl, enviado em X-TraderBot-Token. Opcional.
FLASK_TOKEN=
# Chave de assinatura da sessão. Se vazia, é gerada em data/.flask_secret
FLASK_SECRET_KEY=
# Marque como 1 quando o dashboard estiver atrás de HTTPS.
FLASK_COOKIE_SECURE=0
